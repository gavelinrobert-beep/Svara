generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  passwordHash      String
  phone             String?
  notificationEmail String?
  notificationPhone String?
  createdAt         DateTime           @default(now())
  leads             Lead[]
  distributions     LeadDistribution[]
}

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  nameSv      String
  rotEligible Boolean @default(false)
  rutEligible Boolean @default(false)
  leads       Lead[]
}

enum LeadStatus {
  NY
  PAGAENDE
  VUNNEN
  FORLORAD
}

enum MessageSender {
  AI
  CUSTOMER
  BUSINESS
}

enum DeliveryChannel {
  EMAIL
  SMS
  INTERNAL
}

model Lead {
  id               String             @id @default(cuid())
  businessId       String?
  business         Business?          @relation(fields: [businessId], references: [id])
  name             String
  phoneE164        String
  email            String
  description      String
  postalCode       String
  city             String
  categoryId       String?
  category         Category?          @relation(fields: [categoryId], references: [id])
  status           LeadStatus         @default(NY)
  priceEstimateMin Float?
  priceEstimateMax Float?
  consentAt        DateTime
  createdAt        DateTime           @default(now())
  messages         Message[]
  images           LeadImage[]
  distributions    LeadDistribution[]
}

model Message {
  id              String          @id @default(cuid())
  leadId          String
  lead            Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  sender          MessageSender
  content         String
  edited          Boolean         @default(false)
  originalContent String?
  sentAt          DateTime        @default(now())
  deliveryChannel DeliveryChannel
}

model LeadImage {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  url       String
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorType String
  actorId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}

model LeadDistribution {
  id         String   @id @default(cuid())
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id])
  businessId String
  business   Business @relation(fields: [businessId], references: [id])
  status     String   @default("SENT")
  sentAt     DateTime @default(now())

  @@unique([leadId, businessId])
}

model PostnummerGeo {
  postalCode String @id
  kommun     String
  lan        String
}
