# =============================================================================
# Svara — .env.example
# Copy this file to .env and fill in the values before starting.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://svara:svarapass@localhost:5432/svara
POSTGRES_USER=svara
POSTGRES_PASSWORD=svarapass
POSTGRES_DB=svara

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: override the model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# ── App URLs ──────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ── SMTP (email notifications) ────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@svara.se

# ── SMS (optional) ────────────────────────────────────────────────────────────
# Leave SMS_PROVIDER blank to disable SMS (logs to console).
# SMS_PROVIDER=twilio
# SMS_FROM=+46700000000

# Twilio (if SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...

# 46elks (if SMS_PROVIDER=46elks)
# ELKS_API_USER=u...
# ELKS_API_PASS=...

# ── Single-tenant business assignment ─────────────────────────────────────────
# Optional: set to the business ID to always route leads to that business.
# If blank, the first business in the DB is used (auto-assigned after seed).
# BUSINESS_ID=

# ── Backend port ──────────────────────────────────────────────────────────────
PORT=3001
